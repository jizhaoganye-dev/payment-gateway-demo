# ============================================================================
# 金融決済システム バックエンド Dockerfile
# マルチステージビルドによる本番最適化
# ============================================================================

# ============================================================================
# Stage 1: ビルドステージ
# ============================================================================
FROM eclipse-temurin:17-jdk-alpine AS builder

WORKDIR /app

# Maven Wrapper をコピー
COPY backend/payment-service/mvnw .
COPY backend/payment-service/.mvn .mvn

# pom.xml を先にコピーして依存関係をキャッシュ
COPY backend/payment-service/pom.xml .

# 依存関係のダウンロード（キャッシュ効率化）
RUN chmod +x mvnw && \
    ./mvnw dependency:go-offline -B

# ソースコードをコピー
COPY backend/payment-service/src src

# ビルド実行（テストスキップ - CI/CDで別途実行）
RUN ./mvnw clean package -DskipTests -B

# JAR ファイルの展開（起動時間短縮のため）
RUN java -Djarmode=layertools -jar target/*.jar extract

# ============================================================================
# Stage 2: ランタイムステージ
# ============================================================================
FROM eclipse-temurin:17-jre-alpine AS runtime

# セキュリティ: 非rootユーザーで実行
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

WORKDIR /app

# タイムゾーン設定（日本）
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Tokyo /etc/localtime && \
    echo "Asia/Tokyo" > /etc/timezone && \
    apk del tzdata

# Spring Boot レイヤーをコピー（キャッシュ効率化）
COPY --from=builder /app/dependencies/ ./
COPY --from=builder /app/spring-boot-loader/ ./
COPY --from=builder /app/snapshot-dependencies/ ./
COPY --from=builder /app/application/ ./

# ディレクトリ所有権を変更
RUN chown -R appuser:appgroup /app

# 非rootユーザーに切り替え
USER appuser

# JVMチューニング用の環境変数
ENV JAVA_OPTS="-XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:InitialRAMPercentage=50.0 \
    -XX:+UseG1GC \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/app/logs \
    -Djava.security.egd=file:/dev/./urandom"

# Spring Boot プロファイル
ENV SPRING_PROFILES_ACTIVE=prod

# アプリケーションポート
EXPOSE 8080

# ヘルスチェック
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/api/v1/payments/health || exit 1

# アプリケーション起動
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS org.springframework.boot.loader.launch.JarLauncher"]
